rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Ring clips ────────────────────────────────────────────────────────────
    // Visitors upload a short video clip when they ring (from the browser).
    // sessionId acts as an ephemeral token (UUID, TTL enforced in Firestore).
    // Anyone with the URL can read (needed for sharing with third parties).
    match /rings/{sessionId}/clip.{ext} {
      // Public read — URL is long & unguessable (UUID-based)
      allow read: if true;

      // Visitor write: unauthenticated OK, but enforce file size (max 30 MB)
      // and content type (video only).
      allow write: if
        request.resource.size < 30 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
    }

    // ── Default: require auth for everything else ─────────────────────────────
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
