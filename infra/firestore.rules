rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUnitMember(unitId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/units/$(unitId)).data.memberUids;
    }

    function isUnitOwner(unitId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/units/$(unitId)).data.ownerUid == request.auth.uid;
    }

    function sessionBelongsToUnit(unitId) {
      return isUnitMember(unitId);
    }

    // ─── Units ───────────────────────────────────────────────────────────────
    // Only members can read their unit. Only owner can write.
    match /units/{unitId} {
      allow read: if isUnitMember(unitId);
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerUid == request.auth.uid;
      allow update: if isUnitOwner(unitId);
      allow delete: if false; // soft-delete only
    }

    // ─── Doors ───────────────────────────────────────────────────────────────
    // Public read (visitor needs to validate doorId), member write.
    match /doors/{doorId} {
      allow read: if true;  // public — doorId is embedded in QR URL
      allow write: if isUnitMember(resource.data.unitId) ||
                      (request.resource != null && isUnitMember(request.resource.data.unitId));
    }

    // ─── Sessions ────────────────────────────────────────────────────────────
    // Sessions are created by the ring Cloud Function (admin SDK, bypasses rules).
    // Visitor can read/write their own session (by sessionId from ring response).
    // Resident can read/update sessions belonging to their unit.
    match /sessions/{sessionId} {
      allow read: if true;  // visitor needs sessionId to poll state
      // Visitor writes SDP offer or ICE candidates
      allow update: if (
        // Only allow visitor to write offer/ICE fields (not status or sensitive fields)
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['offer', 'iceVisitor'])
      ) || isUnitMember(resource.data.unitId);
      allow create: if false; // created only by Cloud Function
      allow delete: if false;

      // Messages subcollection (AI concierge conversation)
      match /messages/{msgId} {
        allow read: if isUnitMember(
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.unitId
        ) || true; // visitor reads via their sessionId
        allow create: if true;  // visitor and AI write messages
        allow update, delete: if false;
      }
    }

    // ─── Rate limits ─────────────────────────────────────────────────────────
    // Written only by Cloud Functions (admin SDK). Never client-writable.
    match /ring_rate_limits/{ip} {
      allow read, write: if false;
    }

    // ─── Default deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
