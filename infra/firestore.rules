rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUnitMember(unitId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/units/$(unitId)).data.memberUids;
    }

    function isUnitOwner(unitId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/units/$(unitId)).data.ownerUid == request.auth.uid;
    }

    // ─── Units ───────────────────────────────────────────────────────────────
    match /units/{unitId} {
      allow read: if isUnitMember(unitId);
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerUid == request.auth.uid;
      allow update: if isUnitOwner(unitId);
      allow delete: if false;
    }

    // ─── Doors ───────────────────────────────────────────────────────────────
    match /doors/{doorId} {
      allow read: if true;
      allow write: if isUnitMember(resource.data.unitId) ||
                      (request.resource != null && isUnitMember(request.resource.data.unitId));
    }

    // ─── Sessions ────────────────────────────────────────────────────────────
    // Sessions are created by the ring Cloud Function (admin SDK, bypasses rules).
    // The sessionId acts as a capability token — both visitor and resident receive
    // it via trusted channels (API response / WhatsApp deep link).
    match /sessions/{sessionId} {
      allow read: if true;

      // Visitor and resident (may be unauthenticated) update only these fields.
      // The sessionId capability restricts who can find and update a session.
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['offer', 'status', 'iceVisitor', 'clipUrl', 'clipMime',
                    'quickReply', 'quickReplyAt', 'aiActive', 'answer'])
      ) || isUnitMember(resource.data.unitId);

      allow create: if false; // created only by Cloud Function
      allow delete: if false;

      // WebRTC ICE candidates — written by both visitor and resident
      match /ice/{iceId} {
        allow read, create: if true;
      }

      // AI concierge conversation
      match /messages/{msgId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    // ─── Rate limits ─────────────────────────────────────────────────────────
    match /ring_rate_limits/{ip} {
      allow read, write: if false;
    }

    // ─── Default deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
