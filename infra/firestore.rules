rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUnitMember(unitId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/units/$(unitId)).data.memberUids;
    }

    function isUnitOwner(unitId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/units/$(unitId)).data.ownerUid == request.auth.uid;
    }

    function isBuildingAdmin(buildingId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/buildings/$(buildingId)).data.adminUid == request.auth.uid;
    }

    // ─── Buildings ───────────────────────────────────────────────────────────
    // Public read (visitor needs building name); only admin writes.
    match /buildings/{buildingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.adminUid == request.auth.uid;
      allow delete: if false;
    }

    // ─── Units ───────────────────────────────────────────────────────────────
    match /units/{unitId} {
      allow read: if isUnitMember(unitId)
                  || (isAuthenticated() && resource.data.ownerUid == request.auth.uid)
                  || (resource.data.buildingId != null && resource.data.visible != false);
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isUnitOwner(unitId)
                    || isUnitMember(unitId)
                    || (resource.data.buildingId != null && isBuildingAdmin(resource.data.buildingId));
      allow delete: if false;
    }

    // ─── Doors ───────────────────────────────────────────────────────────────
    match /doors/{doorId} {
      allow read: if true;
      allow write: if isUnitMember(resource.data.unitId)
                   || (request.resource != null && isUnitMember(request.resource.data.unitId))
                   || (resource.data.buildingId != null && isBuildingAdmin(resource.data.buildingId))
                   || (request.resource != null && request.resource.data.buildingId != null
                       && isBuildingAdmin(request.resource.data.buildingId));
    }

    // ─── Sessions ────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if true;
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['offer', 'status', 'iceVisitor', 'clipUrl', 'clipMime',
                    'quickReply', 'quickReplyAt', 'aiActive', 'answer'])
      ) || isUnitMember(resource.data.unitId);
      allow create: if false;
      allow delete: if false;

      match /ice/{iceId} {
        allow read, create: if true;
      }

      match /messages/{msgId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    // ─── Rate limits ─────────────────────────────────────────────────────────
    match /ring_rate_limits/{ip} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
